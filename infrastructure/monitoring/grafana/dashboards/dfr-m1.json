        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "title": "confirm 等待 P95（单次请求内）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 55
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
