{
  "uid": "dfr-m1",
  "title": "DFR M1 — Gateway / Core / Adapter / Provider / Transaction",
  "description": "DFR M1 five-family metrics overview. Metric names match the code; tests/contract/monitoring-config.test.ts verifies there is no drift.",
  "tags": [
    "dfr",
    "m1"
  ],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API request rate (by status code)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (status_code) (rate(dfr_gateway_requests_total[5m]))",
          "legendFormat": "{{status_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "Derived from dfr_gateway_requests_total; when 5xx rises, look at the route dimension first."
    },
    {
      "id": 2,
      "title": "API latency P50 / P95 / P99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(dfr_gateway_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(dfr_gateway_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(dfr_gateway_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "5xx share",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum(rate(dfr_gateway_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(dfr_gateway_requests_total[5m]))",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "Alert threshold 2% (DfrApiErrorRateHigh)."
    },
    {
      "id": 4,
      "title": "In-flight requests (by route class)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (route_class) (dfr_gateway_inflight_requests)",
          "legendFormat": "{{route_class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Auth failures / rate limiting",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (reason_code) (rate(dfr_gateway_auth_failures_total[5m]))",
          "legendFormat": "auth {{reason_code}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (route_class) (rate(dfr_gateway_rate_limited_total[5m]))",
          "legendFormat": "limited {{route_class}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (outcome) (rate(dfr_gateway_idempotency_hits_total[5m]))",
          "legendFormat": "idem {{outcome}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Provider availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "dfr_provider_availability_ratio",
          "legendFormat": "{{provider_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "= 1 − error rate over the health window; recorded as 1 with no samples (a newly registered Provider does not false-alarm)."
    },
    {
      "id": 7,
      "title": "Provider circuit breaker state (1=open)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "dfr_provider_circuit_state{state=\"open\"}",
          "legendFormat": "{{provider_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "When all breakers are open, DfrProviderAllUnavailable fires (urgent)."
    },
    {
      "id": 8,
      "title": "Provider score / error rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "dfr_provider_score",
          "legendFormat": "score {{provider_id}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "dfr_provider_error_ratio",
          "legendFormat": "err {{provider_id}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Provider request rate and retries",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (provider_id,status) (rate(dfr_provider_requests_total[5m]))",
          "legendFormat": "{{provider_id}} {{status}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (provider_id,reason) (rate(dfr_provider_retries_total[5m]))",
          "legendFormat": "retry {{provider_id}} {{reason}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "Retries with reason=write must always be 0 (the write path forbids automatic retries)."
    },
    {
      "id": 10,
      "title": "Adapter call rate (by method class / status)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (adapter,method_class,status) (rate(dfr_adapter_calls_total[5m]))",
          "legendFormat": "{{adapter}} {{method_class}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "method_class=write should only ever be broadcast."
    },
    {
      "id": 11,
      "title": "Adapter errors / registry mismatch",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (chain,error_code) (rate(dfr_adapter_errors_total[5m]))",
          "legendFormat": "{{chain}} {{error_code}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (chain) (increase(dfr_adapter_registry_mismatch_total[10m]))",
          "legendFormat": "mismatch {{chain}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "registry_mismatch is normally always 0; a non-zero value fires the urgent alert."
    },
    {
      "id": 12,
      "title": "Core operation rate and errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 39
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (operation,status) (rate(dfr_core_operations_total[5m]))",
          "legendFormat": "{{operation}} {{status}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (error_code,category) (rate(dfr_core_errors_total[5m]))",
          "legendFormat": "err {{error_code}} {{category}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Core capability unsupported (should always be 0)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 39
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (chain,capability) (increase(dfr_core_capability_unsupported_total[10m]))",
          "legendFormat": "{{chain}} {{capability}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Transaction stage counts (by stage / status)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 47
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (stage,status) (rate(dfr_transaction_stage_total[5m]))",
          "legendFormat": "{{stage}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "Transaction stage latency P95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 47
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le,stage) (rate(dfr_transaction_stage_duration_seconds_bucket[5m])))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "title": "confirm wait P95 (within a single request)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 55
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le,chain) (rate(dfr_transaction_finality_wait_seconds_bucket[15m])))",
          "legendFormat": "{{chain}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Measures only the wait inside a single confirm request, not the end-to-end latency from creation to finality."
    },
    {
      "id": 17,
      "title": "Reorgs / tracker lease outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 55
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (chain,depth_bucket) (increase(dfr_transaction_reorg_total[15m]))",
          "legendFormat": "reorg {{chain}} {{depth_bucket}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (chain,outcome) (increase(dfr_transaction_tracker_lease_total[15m]))",
          "legendFormat": "lease {{chain}} {{outcome}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "title": "Dependency failure actively rejecting traffic",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 63
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (route_class) (increase(dfr_gateway_dependency_rejected_total[5m]))",
          "legendFormat": "{{route_class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "A non-zero value means the transaction store is unavailable and the Gateway is actively rejecting the corresponding business traffic; corresponds to the DfrDependencyRejectingTraffic alert."
    },
    {
      "id": 19,
      "title": "Provider daily quota usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 63
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "dfr_provider_quota_used_ratio",
          "legendFormat": "{{chain}}/{{provider_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit",
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "description": "E5: global Provider daily quota usage from persistent PostgreSQL counts; over 0.8 fires DfrProviderQuotaNearLimit."
    }
  ]
}
