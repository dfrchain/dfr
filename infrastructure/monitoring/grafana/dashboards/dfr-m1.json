{
  "uid": "dfr-m1",
  "title": "DFR M1 — Gateway / Core / Adapter / Provider / Transaction",
  "description": "DFR M1 五族指标总览。指标名与代码一致，由 tests/contract/monitoring-config.test.ts 校验无漂移。",
  "tags": [
    "dfr",
    "m1"
  ],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API 请求速率（按状态码）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (status_code) (rate(dfr_gateway_requests_total[5m]))",
          "legendFormat": "{{status_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "dfr_gateway_requests_total 派生；5xx 上升先看 route 维度。"
    },
    {
      "id": 2,
      "title": "API 延迟 P50 / P95 / P99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(dfr_gateway_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(dfr_gateway_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(dfr_gateway_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "5xx 比例",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum(rate(dfr_gateway_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(dfr_gateway_requests_total[5m]))",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "告警阈值 2%（DfrApiErrorRateHigh）。"
    },
    {
      "id": 4,
      "title": "在途请求（按路由类）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (route_class) (dfr_gateway_inflight_requests)",
          "legendFormat": "{{route_class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "鉴权失败 / 限流",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (reason_code) (rate(dfr_gateway_auth_failures_total[5m]))",
          "legendFormat": "auth {{reason_code}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (route_class) (rate(dfr_gateway_rate_limited_total[5m]))",
          "legendFormat": "limited {{route_class}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (outcome) (rate(dfr_gateway_idempotency_hits_total[5m]))",
          "legendFormat": "idem {{outcome}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Provider 可用率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "dfr_provider_availability_ratio",
          "legendFormat": "{{provider_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "= 1 − 健康窗口错误率；无样本时记为 1（新注册 Provider 不误报）。"
    },
    {
      "id": 7,
      "title": "Provider 熔断状态（1=open）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "dfr_provider_circuit_state{state=\"open\"}",
          "legendFormat": "{{provider_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "熔断全开时触发 DfrProviderAllUnavailable（紧急）。"
    },
    {
      "id": 8,
      "title": "Provider 评分 / 错误率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "dfr_provider_score",
          "legendFormat": "score {{provider_id}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "dfr_provider_error_ratio",
          "legendFormat": "err {{provider_id}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Provider 请求速率与重试",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (provider_id,status) (rate(dfr_provider_requests_total[5m]))",
          "legendFormat": "{{provider_id}} {{status}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (provider_id,reason) (rate(dfr_provider_retries_total[5m]))",
          "legendFormat": "retry {{provider_id}} {{reason}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "reason=write 的重试必须恒为 0（写路径禁止自动重试）。"
    },
    {
      "id": 10,
      "title": "Adapter 调用速率（按方法类别 / 状态）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (adapter,method_class,status) (rate(dfr_adapter_calls_total[5m]))",
          "legendFormat": "{{adapter}} {{method_class}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "method_class=write 只应是 broadcast。"
    },
    {
      "id": 11,
      "title": "Adapter 错误 / registry 不一致",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (chain,error_code) (rate(dfr_adapter_errors_total[5m]))",
          "legendFormat": "{{chain}} {{error_code}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (chain) (increase(dfr_adapter_registry_mismatch_total[10m]))",
          "legendFormat": "mismatch {{chain}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "registry_mismatch 正常恒为 0；非 0 触发紧急告警。"
    },
    {
      "id": 12,
      "title": "Core 操作速率与错误",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfr-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 39
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (operation,status) (rate(dfr_core_operations_total[5m]))",
          "legendFormat": "{{operation}} {{status}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfr-prom"
          },
          "expr": "sum by (error_code,category) (rate(dfr_core_errors_total[5m]))",
          "legendFormat": "err {{error_code}} {{category}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      }
    },
