# DFR M1 test database passwords (placeholder values; never fill in real production credentials)
#
# Copy to .env and replace with random values; .env is excluded by
# .gitignore and is not committed.
# Example generator: openssl rand -base64 32
DFR_POSTGRES_BOOTSTRAP_PASSWORD=change-me-bootstrap
DFR_POSTGRES_MIGRATOR_PASSWORD=change-me-migrator
DFR_POSTGRES_RUNTIME_PASSWORD=change-me-runtime

# ---------------------------------------------------------------------------
# Extra variables needed by docker-compose.m1.yml (the M1 local all-in-one sample).
# The test database (docker-compose.test.yml) does not need these.
# ---------------------------------------------------------------------------

# Gateway auth: keyId is an 8-char public identifier; hash is the
# sha256(secret+pepper) of the secret.
# Example generator (do not write the plaintext secret into this file):
#   node -e "const c=require('node:crypto');console.log(c.createHash('sha256').update(process.argv[1]+process.argv[2]).digest('hex'))" '<secret>' '<pepper>'
DFR_M0_API_KEY_ID=change-me-keyid
DFR_M0_API_KEY_HASH=change-me-64-hex-sha256
DFR_M0_API_KEY_PEPPER=
DFR_M0_PROJECT_ID=default

# Write-path switch: set to true only when build/simulate/broadcast/confirm is needed.
DFR_M1_ALLOW_WRITE=false

# ADR-038: runtime milestone (M0..M7). Empty = historical behavior (the write switch decides M0/M1).
# BEX's M4 two-chain deployment sets this to M4; values above M0 require the write path to be enabled and the Store ready.
DFR_DEPLOY_MILESTONE=

# Sepolia Providers: endpoints are required; credentials are supplied per endpoint requirements, empty means no credential.
DFR_PROVIDER_ETHEREUM_SEPOLIA_PRIMARY_URL=https://sepolia.example.invalid/v3/REPLACE_ME
DFR_PROVIDER_ETHEREUM_SEPOLIA_PRIMARY_KEY=
DFR_PROVIDER_ETHEREUM_SEPOLIA_SECONDARY_URL=https://sepolia-backup.example.invalid
DFR_PROVIDER_ETHEREUM_SEPOLIA_SECONDARY_KEY=

# M4 legs: BEX integration needs base-sepolia / arbitrum-sepolia; empty means that chain is not enabled.
DFR_PROVIDER_BASE_SEPOLIA_PRIMARY_URL=
DFR_PROVIDER_BASE_SEPOLIA_PRIMARY_KEY=
DFR_PROVIDER_ARBITRUM_SEPOLIA_PRIMARY_URL=
DFR_PROVIDER_ARBITRUM_SEPOLIA_PRIMARY_KEY=

# Host port mapping (fixed 8787 inside the container). Default 18787, to avoid clashing with services already on the host.
DFR_GATEWAY_HOST_PORT=18787
