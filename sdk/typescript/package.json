{
  "name": "@dfr/sdk-typescript",
  "version": "0.1.0",
  "private": true,
  "description": "DFR TypeScript SDK (M0 read-only)",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@dfr/types": "workspace:*"
  },
  "devDependencies": {
    "@dfr/errors": "workspace:*",
    "@types/node": "^26.6.4"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
