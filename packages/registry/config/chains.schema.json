{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dfr.local/schemas/chains.schema.json",
  "title": "DFR Chain & Provider Registry",
  "description": "Machine-readable schema for chains.yaml. Startup validation (DFR-005) and CI validation share this file, so rules cannot drift with the implementation (review fix R-13).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "chains", "providers"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "chains": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/chainId" },
      "additionalProperties": { "$ref": "#/$defs/chain" }
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": { "$ref": "#/$defs/provider" }
    }
  },
  "$defs": {
    "chainId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "configRef": {
      "type": "string",
      "pattern": "^(env|file|vault):.+$"
    },
    "capabilityId": {
      "type": "string",
      "enum": [
        "account.balance",
        "account.code",
        "block.read",
        "transaction.read",
        "transaction.build",
        "transaction.simulate",
        "transaction.broadcast",
        "event.subscribe",
        "contract.read",
        "contract.logs",
        "transaction.confirm.native"
      ]
    },
    "finalityPolicy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "confirmations"],
          "properties": {
            "kind": { "const": "confirmations" },
            "confirmations": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "finalizedTag"],
          "properties": {
            "kind": { "const": "checkpoint" },
            "finalizedTag": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "levels"],
          "properties": {
            "kind": { "const": "commitment" },
            "levels": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "enum": ["processed", "confirmed", "finalized"] }
            }
          }
        }
      ]
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName", "family", "network",
        "adapter", "finality", "finalityStatus", "capabilities", "milestone"
      ],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "enum": ["evm", "solana", "bitcoin", "tron", "cosmos"] },
        "network": {
          "type": "string",
          "enum": ["mainnet", "testnet", "devnet", "custom"],
          "description": "Network category. Determined solely by the chain id; a descriptive attribute, not an independent parameter (audit fix A-07)."
        },
        "externalChainId": { "type": "string" },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "finality": { "$ref": "#/$defs/finalityPolicy" },
        "finalityStatus": {
          "type": "string",
          "enum": ["unverified", "verified"],
          "description": "unverified means the finality parameters have not been verified against a real RPC; DFR-014 is responsible for upgrading them to verified and recording evidence (review fix R-22)."
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capabilityId" }
        },
        "milestone": {
          "type": "string",
          "enum": ["M0", "M1", "M2", "M3", "M4", "M5", "M6", "M7"]
        },
        "explorerUrl": { "type": "string", "format": "uri" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain", "kind", "endpointRef", "credentialRef", "priority", "weight", "timeoutMs", "cost"],
      "properties": {
        "chain": { "$ref": "#/$defs/chainId" },
        "kind": { "type": "string", "enum": ["json-rpc-http", "json-rpc-ws", "grpc", "rest"] },
        "endpointRef": { "$ref": "#/$defs/configRef" },
        "credentialRef": {
          "oneOf": [
            { "$ref": "#/$defs/configRef" },
            { "const": "none" }
          ]
        },
        "archive": {
          "type": "boolean",
          "description": "Whether this is an archive node. ProviderRequirements.requiresArchive filters on this (audit fix A-26)."
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "0..10, on the same scale as the scoring formula priorityBonus(0..10) (review fix R-14)."
        },
        "weight": { "type": "integer", "minimum": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 60000 },
        "quota": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requestsPerSecond": { "type": "integer", "minimum": 1 },
            "requestsPerDay": { "type": "integer", "minimum": 1 }
          }
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "priceUsd"],
          "properties": {
            "unit": { "type": "string", "enum": ["request", "compute-unit", "gb"] },
            "priceUsd": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" }
          }
        }
      }
    }
  }
}
