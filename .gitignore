# ---- Dependencies ----
node_modules/
.pnpm-store/

# ---- Build output ----
dist/
apps/docs/public-dist/
build/
out/
# Generated SBOMs are build artifacts (reproducible via scripts/image-supply-chain.sh); do not commit them.
infrastructure/docker/sbom/
*.tsbuildinfo
coverage/
# Probe artifacts (log-volume / read-latency, etc.): reproducible via the matching `pnpm probe:*`; do not commit them.
artifacts/

# ---- Secrets (SECURITY CRITICAL) ----
# No key file of any form may enter the repository (see docs/adr/ADR-007-signing-model.md)
.env
.env.*
!.env.example
*.env
*.key
*.pem
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
id_ed25519*
id_ecdsa*
secrets/
.secrets/

# ---- Local / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# ---- Logs / temp ----
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
logs/
tmp/
.tmp/
.cache/

# ---- Test / tooling caches ----
.vitest/
.eslintcache
.turbo/

# ---- Local registry overrides ----
# Local Provider credentials live only in .env (600); never commit them
packages/registry/config/local.*.yaml
coverage-check-verify/
